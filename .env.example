# Copy to .env for local dev, or set these in your hosting provider / docker-compose.

# SQLite database (relative to project root, or absolute path)
DATABASE_URL="file:./db/custom.db"

# Used by the chat Socket.io mini-service (must point at the same SQLite file)
DATABASE_PATH="./db/custom.db"

# Auth (required in production)
# Generate: openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost"

# Next.js production server
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Optional: override Socket.io client URL (default routes via Caddy on port 80)
# NEXT_PUBLIC_SOCKET_IO_URL="/?XTransformPort=3003"
