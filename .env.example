# Copy to .env for local dev, or set these in Vercel → Project → Settings → Environment Variables.

# MySQL (Railway: use the *public* URL, not mysql.railway.internal — Vercel cannot reach internal hosts)
# Append ?connection_limit=1 for serverless (Vercel) if you see "too many connections" errors.
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/railway?connection_limit=1"

# Used by the chat Socket.io mini-service (Docker only; not used on Vercel)
DATABASE_PATH="./db/custom.db"

# Auth (required in production)
# Generate: openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="https://your-app.vercel.app"

# Next.js production server
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Optional: override Socket.io client URL (requires chat service hosted separately)
# NEXT_PUBLIC_SOCKET_IO_URL="https://your-chat-service.example.com"
